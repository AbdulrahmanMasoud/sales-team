# Usually filled in by the dashboard setup page. To do it by hand, copy this file to .env and fill in your values.
# Keep .env on your machine only and never share it.

# Business Settings > System users > Generate token (permissions: ads_read, ads_management, business_management)
META_ACCESS_TOKEN=

# Ad account ID (from Ads Manager: the number after act= in the URL)
META_AD_ACCOUNT_ID=

# Optional but recommended: the app's App secret from Meta for Developers (adds appsecret_proof to every request)
META_APP_SECRET=

# Optional: Meta's official ads MCP (user access token with ads_mcp_management). Steps in README.
META_MCP_TOKEN=

# Optional: Telegram (steps in README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
# META_GRAPH_VERSION=v26.0
# PORT=8765
