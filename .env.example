# انسخ الملف ده باسم .env وحط القيم بتاعتك. الملف ده متقراش غير على جهازك، وماتبعتهوش لحد.

# من Business Settings › System users › Generate token (صلاحيات: ads_read و ads_management)
META_ACCESS_TOKEN=

# رقم حساب الإعلانات (من Ads Manager، الرقم اللي في الـURL بعد act=)
META_AD_ACCOUNT_ID=

# اختياري بس مستحسن: App secret بتاع الـapp على Meta for Developers (بيضيف appsecret_proof لكل طلب)
META_APP_SECRET=

# اختياري: الـMCP الرسمي بتاع Meta (user access token فيه صلاحية ads_mcp_management). الخطوات في README.
META_MCP_TOKEN=

# اختياري: Telegram (الخطوات في README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# اختياري
# META_GRAPH_VERSION=v26.0
# PORT=8765
